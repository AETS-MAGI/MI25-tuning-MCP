{
  "bridge": {
    "max_rounds": 4,
    "system_prompt": "You are an MI25/gfx900 tuning assistant. Prefer MCP tools over guesses. Use only the allowed tools set for this session and keep tool calls minimal."
  },
  "agent": {
    "max_tool_roundtrips": 4,
    "allowed_tools": [
      "mi25_tuning__ping",
      "mi25_tuning__get_gpu_metrics",
      "mi25_tuning__get_config",
      "mi25_tuning__update_config",
      "mi25_tuning__run_inference",
      "mi25_tuning__read_perf_log",
      "mi25_tuning__summarize_perf_log",
      "rocm_ops__rocm_status",
      "rocm_ops__ollama_health"
    ]
  },
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "model": "gpt-oss:latest"
  },
  "mcpServers": {
    "mi25_tuning": {
      "command": "/home/limonene/ROCm-project/MI25-tuning-MCP/.venv/bin/mi25-tuning-mcp",
      "args": [],
      "cwd": "/home/limonene/ROCm-project/MI25-tuning-MCP",
      "env": {
        "MI25_CLIENT_ROOT": "/home/limonene/ROCm-project/multi_llm-client",
        "MI25_NOTES_ROOT": "/home/limonene/ROCm-project/Agents-note",
        "MI25_MCP_AUDIT_LOG": "/home/limonene/ROCm-project/MI25-tuning-MCP/logs/tool-calls.jsonl"
      }
    },
    "rocm_ops": {
      "command": "/home/limonene/ROCm-project/ROCm-ollama-mcp/mcp-rocm-ops/.venv/bin/rocm-ops-mcp",
      "args": [],
      "cwd": "/home/limonene/ROCm-project/ROCm-ollama-mcp/mcp-rocm-ops",
      "env": {
        "ROCM_OPS_MI25_BUILD_ROOT": "/home/limonene/ROCm-project/ROCm-MI25-build",
        "ROCM_OPS_MODELS_DIR": "/home/limonene/ROCm-project/ollama-models",
        "ROCM_OPS_OLLAMA_BASE_URL": "http://127.0.0.1:11434"
      }
    },
    "rocm_ops_b": {
      "command": "/home/limonene/ROCm-project/ROCm-ollama-mcp/mcp-host-info/server.py",
      "args": [],
      "cwd": "/home/limonene/ROCm-project/ROCm-ollama-mcp/mcp-host-info",
      "env": {}
    }
  }
}
